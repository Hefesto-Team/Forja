; Engine configuration file.
; Godot 4.4 — FORJA, a Hefesto Tech Demo: quatro DualSense como a Sony e a Steam documentam.
config_version=5

[application]
config/name="FORJA"
config/description="Hefesto Tech Demo: quatro DualSense no mesmo sofá. USB 0x02, player index 0..3."
config/version="0.3.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")

[audio]

driver/enable_input=true

[autoload]

Forja="*res://scripts/forja.gd"
Som="*res://scripts/som.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom_font="res://assets/fontes/SpaceGrotesk-wght.ttf"

[input_devices]

pointing/emulate_touch_from_mouse=false

[rendering]

renderer/rendering_method="forward_plus"
environment/defaults/default_clear_color=Color(0.0667, 0.0706, 0.102, 1)
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
