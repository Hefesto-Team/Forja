{
  "_leia": "As regras do portão de arte (scripts/portoes/arte.py). Os números vêm da bíblia de arte, docs/jogo/arte/02-cor-e-letra.md; quando a bíblia mudar, muda aqui junto. Virar para reprovar: \"modo\": \"reprova\" (a ficha V08).",
  "modo": "aviso",
  "fonte_das_regras": "docs/jogo/arte/02-cor-e-letra.md",
  "escopo": ["godot/scripts", "godot/scenes", "godot/project.godot"],
  "extensoes": [".gd", ".tscn", ".tres", ".godot"],
  "ignorar": ["godot/addons/", "godot/estudos/", "godot/testes/"],
  "arquivo_de_tokens": "godot/scripts/tema.gd",
  "tokens": {
    "FITA": "#0d0a16",
    "CASCO": "#17121f",
    "CASCO_ALTO": "#241c30",
    "GRAFITE": "#3a3346",
    "JANELA": "#07050c",
    "ETIQUETA": "#efe4c8",
    "ETIQUETA_SOMBRA": "#cfc2a0",
    "TINTA": "#1c1626",
    "TINTA_SUAVE": "#5a4f66",
    "MUDO": "#857a95",
    "VIOLETA": "#4a3aa8",
    "VIOLETA_FUNDO": "#1d1638",
    "TUNGSTENIO": "#ffd9a8",
    "OXIDO": "#3b2a22",
    "OXIDO_BRILHO": "#7a5640",
    "ERRO_R": "#ff2a4a",
    "ERRO_B": "#2a6bff",
    "SECAO_0": "#c8432f",
    "SECAO_1": "#2f55c4",
    "SECAO_2": "#1f8a7e",
    "SECAO_3": "#c79a2a",
    "SECAO_4": "#86409a"
  },
  "jogadores": {
    "ciano": "#29e6ff",
    "magenta": "#ff3ea5",
    "limao": "#d4ff4a",
    "ambar": "#ee9a1e"
  },
  "cores_nomeadas_permitidas": ["TRANSPARENT"],
  "jogador_por_indice_literal": ["JOGADOR\\[\\s*\\d+\\s*\\]", "cor_do_lugar\\(\\s*\\d+\\s*\\)"],
  "jogador_indice_literal_permitido": ["godot/scripts/tema.gd"],
  "fontes": ["Bungee-Regular.ttf", "VT323-Regular.ttf", "ArchivoNarrow-wght.ttf", "PermanentMarker-Regular.ttf"],
  "pasta_das_fontes": "godot/assets/fontes",
  "tamanho_minimo": 30,
  "chamadas_com_tamanho": {
    "Desenho.texto": 4,
    "Desenho.paragrafo": 4,
    "Desenho.selo": 4,
    "Glifo.dica": 4,
    "Tema.rotulo": 2,
    "add_theme_font_size_override": 1
  },
  "tamanho_em_cena": ["font_size\\s*=\\s*(\\d+)"],
  "constantes_de_tamanho": "^const\\s+T_[A-Z_]+\\s*:?=\\s*(\\d+)"
}
