# DualSense USB hidraw — FORJA escreve o relatório 0x02 direto.
# Instalar: sudo cp udev/99-forja-dualsense.rules /etc/udev/rules.d/ && sudo udevadm control --reload-rules && sudo udevadm trigger
KERNEL=="hidraw*", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="0ce6", MODE="0666", GROUP="plugdev"
KERNEL=="hidraw*", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="0df2", MODE="0666", GROUP="plugdev"
